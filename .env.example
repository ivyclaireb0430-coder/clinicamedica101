# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="file:./dev.db"

# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# 32-byte key, base64. Encrypts sensitive fields (health concerns, clinical notes, tokens).
# Generate with `openssl rand -base64 32`. Losing this key = losing encrypted data. Back it up offline.
ENCRYPTION_KEY=""

# Google Cloud OAuth client (Web application). Redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret for the cron endpoint (/api/cron/*). Generate a long random string.
CRON_SECRET=""

# Meta Messenger (Facebook Page). Never paste these in chat; put them only in the server's environment settings.
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ID=""
META_PAGE_ACCESS_TOKEN=""
# Any long random string; enter the same value as "Verify token" in the Meta app webhook settings.
META_VERIFY_TOKEN=""
META_GRAPH_VERSION="v25.0"

# SMS fallback (Semaphore). Paid per message. Leave empty to keep SMS off.
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""
