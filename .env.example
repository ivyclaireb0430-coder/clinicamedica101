# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="file:./dev.db"

# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# 32-byte key, base64. Encrypts sensitive fields (health concerns, clinical notes, tokens).
# Generate with `openssl rand -base64 32`. Losing this key = losing encrypted data. Back it up offline.
ENCRYPTION_KEY=""

# Google Cloud OAuth client (Web application). Redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret for the cron endpoint (/api/cron/*). Generate a long random string.
CRON_SECRET=""
