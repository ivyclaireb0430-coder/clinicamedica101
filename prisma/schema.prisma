// Clinica Medica 101 — data model.
// Dev uses SQLite. For production switch provider to "postgresql" (see docs/DEPLOY.md).
// Fields ending in "Enc" are AES-256-GCM encrypted by src/lib/crypto.ts before saving.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────── Users & security ─────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           String // OWNER | DOCTOR | FRONT_DESK
  totpSecretEnc  String?
  totpEnabled    Boolean   @default(false)
  active         Boolean   @default(true)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditLogs      AuditLog[]
  stageChanges   LeadStageChange[]
  googleAccount  GoogleAccount?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // VIEW | CREATE | UPDATE | DELETE | LOGIN | LOGIN_FAILED | EXPORT ...
  entity    String // Lead | Appointment | User ...
  entityId  String?
  detail    String? // never patient health data
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

// ───────────── Marketing (attribution) ─────────────

model Campaign {
  id           String   @id @default(cuid())
  name         String
  channel      String // FB_REEL | FB_POST | RADIO | REFERRAL | OTHER
  trackingCode String   @unique // used as m.me ?ref= value
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  createdAt    DateTime @default(now())

  leads        Lead[]
}

// ───────────── Inquiries / leads ─────────────

model Lead {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String?
  psid            String?   @unique // Messenger page-scoped ID
  mobile          String?
  email           String?
  source          String // MESSENGER | FB_REEL | FB_POST | RADIO | REFERRAL | WALK_IN | WEBSITE | OTHER
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  concernEnc      String? // short health concern (sensitive, encrypted)
  stage           String    @default("NEW")
  lostReason      String?
  privacyConsent  Boolean   @default(false)
  consentAt       DateTime?
  firstContactAt  DateTime  @default(now())
  lastContactAt   DateTime  @default(now())
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stageChanges    LeadStageChange[]
  appointments    Appointment[]
  conversation    Conversation?
  patient         Patient?
  intakeForms     IntakeForm[]

  @@index([stage])
}

model LeadStageChange {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage String?
  toStage   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([toStage, createdAt])
}

model Script {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. first_reply, fee, no_show_rebook
  title     String
  category  String
  body      String // Taglish, placeholders {first_name} {date} {time}
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ───────────── Booking ─────────────

model ConsultationType {
  id           String   @id @default(cuid())
  name         String
  description  String?
  durationMin  Int
  feePhp       Int // whole pesos
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)

  appointments Appointment[]
}

model ScheduleRule {
  id        String @id @default(cuid())
  weekday   Int // 0 = Sunday … 6 = Saturday (Manila time)
  startTime String // "09:00"
  endTime   String // "17:00"
}

model BlockedDate {
  id      String   @id @default(cuid())
  date    String // "YYYY-MM-DD" Manila date
  reason  String?
}

model Appointment {
  id                 String           @id @default(cuid())
  leadId             String
  lead               Lead             @relation(fields: [leadId], references: [id])
  consultationTypeId String
  consultationType   ConsultationType @relation(fields: [consultationTypeId], references: [id])
  startAt            DateTime
  endAt              DateTime
  status             String           @default("BOOKED") // BOOKED | CONFIRMED | ATTENDED | NO_SHOW | CANCELLED | RESCHEDULED
  channel            String           @default("STAFF") // STAFF | MESSENGER | WEBSITE
  googleEventId      String?
  rescheduledFromId  String?
  noShowAutoMarked   Boolean          @default(false)
  assessments        Assessment[]
  sessions           TreatmentSession[]
  charges            Charge[]
  feedback           Feedback?
  notes              String? // scheduling notes only — no clinical content
  reminders          Reminder[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([startAt])
  @@index([status])
}

// Busy times pulled from the doctor's Google Calendar (not clinic appointments).
model ExternalBusy {
  id            String   @id @default(cuid())
  googleEventId String   @unique
  startAt       DateTime
  endAt         DateTime
  summary       String?

  @@index([startAt])
}

model GoogleAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  email           String?
  calendarId      String   @default("primary")
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ───────────── Messenger ─────────────

model Conversation {
  id                String    @id @default(cuid())
  leadId            String    @unique
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  psid              String    @unique
  automationPaused  Boolean   @default(false) // human takeover
  pausedAt          DateTime?
  needsDoctor       Boolean   @default(false) // medical/complaint question waiting for the doctor
  needsDoctorAt     DateTime?
  flowState         String? // JSON: booking flow step and choices
  lastUserMessageAt DateTime? // opens the 24-hour standard messaging window
  lastMessageAt     DateTime  @default(now())
  nudgeSentAt       DateTime?
  unread            Int       @default(0)
  createdAt         DateTime  @default(now())

  messages          Message[]

  @@index([needsDoctor])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String // IN | OUT
  sender         String // PATIENT | BOT | DOCTOR | PAGE (sent from the Facebook Page inbox)
  textEnc        String // encrypted: patients may share health details
  mid            String?      @unique // Meta message ID (dedupe webhook retries)
  status         String       @default("SENT") // SENT | FAILED
  error          String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Reminder {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  kind          String // CONFIRMATION | DAY_BEFORE | DAY_OF | NO_SHOW
  channel       String? // MESSENGER | MESSENGER_UTILITY | EMAIL | SMS | NONE
  status        String // SENT | FAILED | NO_CHANNEL
  error         String?
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, kind])
}

// ───────────── Consultation & treatment (clinical: Owner/Doctor only) ─────────────

model Patient {
  id               String    @id @default(cuid())
  patientNo        String    @unique // e.g. CM-0001
  leadId           String?   @unique
  lead             Lead?     @relation(fields: [leadId], references: [id])
  firstName        String
  lastName         String?
  birthDate        String? // "YYYY-MM-DD"
  sex              String? // FEMALE | MALE | OTHER | UNDISCLOSED
  mobile           String?
  email            String?
  address          String?
  occupation       String?
  emergencyContact String?
  privacyConsent   Boolean   @default(false)
  consentAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  intakeForms      IntakeForm[]
  assessments      Assessment[]
  plans            TreatmentPlan[]
  sessions         TreatmentSession[]
  attachments      Attachment[]
  followUps        FollowUp[]
  progress         ProgressEntry[]
  feedback         Feedback[]
  charges          Charge[]
  payments         Payment[]
  packages         PatientPackage[]

  @@index([lastName, firstName])
}

// Pre-consult form. Sent as a one-time link; answers are encrypted as one JSON blob.
model IntakeForm {
  id             String    @id @default(cuid())
  token          String    @unique
  expiresAt      DateTime
  leadId         String?
  lead           Lead?     @relation(fields: [leadId], references: [id])
  patientId      String?
  patient        Patient?  @relation(fields: [patientId], references: [id])
  status         String    @default("SENT") // SENT | SUBMITTED | FILLED_IN_CLINIC
  answersEnc     String?
  consentGiven   Boolean   @default(false)
  consentVersion String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
}

model Assessment {
  id               String       @id @default(cuid())
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId    String?
  appointment      Appointment? @relation(fields: [appointmentId], references: [id])
  date             DateTime     @default(now())
  authorId         String
  chiefComplaintEnc String?
  symptomsEnc      String?
  examEnc          String? // exam findings
  investigationsEnc String? // investigations requested
  resultsEnc       String? // results / interpretation
  explainedEnc     String? // findings explained to patient
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attachments      Attachment[]

  @@index([patientId, date])
}

// Uploaded files are encrypted on disk (UPLOAD_DIR). Names are encrypted too.
model Attachment {
  id           String      @id @default(cuid())
  patientId    String
  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  kind         String // RESULT | CONSENT_FORM | OTHER
  filenameEnc  String
  mimeType     String
  size         Int
  storageKey   String      @unique
  uploadedById String
  createdAt    DateTime    @default(now())

  consents     TreatmentConsent[]
}

model TreatmentPlan {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title           String // short label, e.g. "Plan 1 – Nov 2026" (no diagnosis)
  status          String    @default("DRAFT") // DRAFT | PROPOSED | ACCEPTED | STARTED | COMPLETED | DECLINED | CANCELLED
  goalsEnc        String?
  scheduleEnc     String? // e.g. weekly for 8 weeks
  benefitsEnc     String?
  risksEnc        String?
  alternativesEnc String?
  declineReason   String?
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  recallSentAt    DateTime? // last "missed session" recall for a stalled plan

  items           TreatmentPlanItem[]
  consent         TreatmentConsent?
  sessions        TreatmentSession[]
}

model TreatmentPlanItem {
  id           String        @id @default(cuid())
  planId       String
  plan         TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  modality     String
  sessions     Int
  unitPricePhp Int
  notes        String?
  sortOrder    Int           @default(0)
}

model TreatmentConsent {
  id                   String        @id @default(cuid())
  planId               String        @unique
  plan                 TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  consentDate          String // "YYYY-MM-DD"
  explainedById        String
  explainedByName      String
  patientAcknowledged  Boolean
  acknowledgement      String // what the patient acknowledged
  signedFormId         String?
  signedForm           Attachment?   @relation(fields: [signedFormId], references: [id])
  createdAt            DateTime      @default(now())
}

model TreatmentSession {
  id               String        @id @default(cuid())
  planId           String
  plan             TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId    String?
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id])
  date             String // "YYYY-MM-DD"
  modality         String
  progressNotesEnc String?
  authorId         String
  createdAt        DateTime      @default(now())
  progress         ProgressEntry?
  charge           Charge?
  packageUse       PackageUse?

  @@index([patientId, date])
}

// ─────────────────────────── Phase 4: Follow-up ───────────────────────────

model FollowUp {
  id                String    @id @default(cuid())
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dueDate           String // "YYYY-MM-DD"
  kind              String // NEXT_SESSION | REASSESSMENT | CHECK_IN
  status            String    @default("OPEN") // OPEN | DONE | CANCELLED
  note              String? // scheduling note only, no clinical content
  recallCount       Int       @default(0)
  lastRecallAt      DateTime?
  lastRecallChannel String?
  lastRecallError   String?
  createdById       String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, dueDate])
}

// Per-visit 0–10 rating of the main complaint (clinical).
model ProgressEntry {
  id        String            @id @default(cuid())
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionId String?           @unique
  session   TreatmentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  date      String // "YYYY-MM-DD"
  score     Int // 0 = worst, 10 = best
  notesEnc  String?
  authorId  String
  createdAt DateTime          @default(now())

  @@index([patientId, date])
}

model Feedback {
  id                 String       @id @default(cuid())
  token              String       @unique
  patientId          String
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId      String?      @unique
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  expiresAt          DateTime
  sentChannel        String?
  sentError          String?
  submittedAt        DateTime?
  rating             Int? // 1–5
  commentEnc         String?
  testimonialConsent Boolean      @default(false)
  displayName        String? // how the patient wants to be named if quoted
  consentVersion     String?
  testimonialHidden  Boolean      @default(false) // owner can stop using it at any time
  createdAt          DateTime     @default(now())
}

// ─────────────────────────── Phase 4: Financial ───────────────────────────
// Amounts are whole pesos. Payments are applied to the oldest unpaid charges first (computed, not stored).

model Charge {
  id            String            @id @default(cuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date          String // "YYYY-MM-DD"
  category      String // CONSULTATION | SESSION | PACKAGE | OTHER
  description   String // service name only, never a diagnosis
  amountPhp     Int
  appointmentId String?
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  sessionId     String?           @unique
  session       TreatmentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  packageId     String?           @unique
  package       PatientPackage?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  voidedAt      DateTime?
  voidReason    String?
  createdById   String
  createdAt     DateTime          @default(now())

  @@index([patientId, date])
  @@index([date])
}

model Payment {
  id           String    @id @default(cuid())
  receiptNo    String    @unique // acknowledgement receipt no., e.g. AR-2026-00001
  orNumber     String? // BIR official receipt number, if one was issued
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date         String // "YYYY-MM-DD"
  amountPhp    Int
  method       String // CASH | GCASH | MAYA | CARD
  reference    String? // GCash/Maya reference or card approval code
  notes        String?
  receivedById String
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime  @default(now())

  @@index([patientId, date])
  @@index([date])
}

// Prepaid sessions.
model PatientPackage {
  id            String       @id @default(cuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name          String
  sessionsTotal Int
  pricePhp      Int
  purchasedOn   String // "YYYY-MM-DD"
  expiresOn     String?
  cancelledAt   DateTime?
  createdById   String
  createdAt     DateTime     @default(now())
  charge        Charge?
  uses          PackageUse[]
}

model PackageUse {
  id        String            @id @default(cuid())
  packageId String
  package   PatientPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sessionId String?           @unique
  session   TreatmentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  date      String
  note      String?
  createdAt DateTime          @default(now())
}
